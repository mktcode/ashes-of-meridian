{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "rootDir": "src",
    "outDir": "dist/src",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": false,
    "noEmitOnError": true,
    "moduleDetection": "legacy"
  },
  "include": ["src/**/*.js", "src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
